        resultsDiv.innerHTML = "";
        results.forEach((sekolah) => {
          const div = document.createElement("div");
          div.className = "school-item";

          div.innerHTML = `
            <div class="school-item-name">${sekolah.nama}</div>
            <div class="school-item-meta">NPSN: ${sekolah.npsn} · ${sekolah.jenjang}</div>
          `;
          div.onclick = () => {
            selectSchool(sekolah);
          };
          resultsDiv.appendChild(div);
        });

        resultsDiv.classList.add("open");
      }

