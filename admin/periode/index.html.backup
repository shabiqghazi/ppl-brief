                    <ul style="padding-left: 1.25rem; margin-top: 0.375rem">
                      <li>IPK minimal 2.75</li>
                      <li>Lulus Micro Teaching</li>
                      <li>Minimal 100 SKS lulus</li>
                      <li>Status mahasiswa aktif</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sekolah Mitra tab -->
            <div class="dtab-panel">
              <div class="flex justify-between items-center mb-4">
                <p class="text-sm text-muted" id="sekolah-count">
                  12 sekolah mitra terdaftar
                </p>
                <div style="display: flex; gap: 0.5rem">
