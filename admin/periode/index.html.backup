          </div>
        </main>
      </div>
    </div>

    <!-- Drawer: Tambah Sekolah Mitra -->
    <div
      class="drawer-overlay"
      id="add-sekolah-drawer-overlay"
      onclick="closeAddSekolahDrawer(event)"
    >
      <div class="drawer" onclick="event.stopPropagation()">
        <div class="drawer-header">
          <h2>Tambah Sekolah Mitra</h2>
          <button class="drawer-close" onclick="closeAddSekolahDrawer()">
            ✕
          </button>
        </div>
        <div class="drawer-content">
          <!-- Toggle Mode -->
          <div class="toggle-mode-group">
            <button
              class="toggle-mode-btn active"
              onclick="switchAddSekolahMode('pilih')"
            >
              Pilih Sekolah
            </button>
            <button
              class="toggle-mode-btn"
              onclick="switchAddSekolahMode('baru')"
            >
              Buat Sekolah Baru
            </button>
          </div>

          <!-- Mode: Pilih Sekolah -->
          <div id="mode-pilih-sekolah">
            <div class="form-group">
              <label class="form-label">Cari Sekolah</label>
              <input
                type="text"
                class="form-input"
                id="pilih-search"
                placeholder="Nama sekolah atau NPSN..."
                onkeyup="searchSekolah()"
              />
            </div>
            <div class="school-search-results" id="school-results"></div>
          </div>

          <!-- Mode: Buat Sekolah Baru -->
          <div id="mode-buat-sekolah" style="display: none">
            <div class="form-group">
              <label class="form-label">Nama Sekolah *</label>
              <input
                type="text"
                class="form-input"
                id="new-sekolah-nama"
                placeholder="Nama sekolah..."
              />
            </div>
            <div class="form-group">
              <label class="form-label">Alamat *</label>
              <textarea
                class="form-input"
                id="new-sekolah-alamat"
                placeholder="Alamat sekolah..."
                style="min-height: 80px"
              ></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">Jenjang *</label>
              <select class="form-input" id="new-sekolah-jenjang">
                <option value="">Pilih jenjang...</option>
                <option value="PAUD/TK">PAUD/TK</option>
                <option value="SD/MI">SD/MI</option>
                <option value="SMP/MTs">SMP/MTs</option>
                <option value="SMA/SMK/MA">SMA/SMK/MA</option>
                <option value="SLB">SLB</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">NPSN *</label>
              <input
                type="text"
                class="form-input"
                id="new-sekolah-npsn"
                placeholder="NPSN..."
              />
            </div>
            <div class="form-group">
              <label class="form-label">Nama PIC</label>
              <input
                type="text"
                class="form-input"
                id="new-sekolah-pic-nama"
                placeholder="Nama PIC..."
              />
            </div>
            <div class="form-group">
              <label class="form-label">Kontak PIC</label>
              <input
                type="text"
                class="form-input"
                id="new-sekolah-pic-kontak"
                placeholder="Nomor telepon atau email..."
              />
            </div>
          </div>

          <!-- Form Kuota -->
          <div class="form-group">
            <label class="form-label">Kuota Program Studi *</label>
            <div class="kuota-rows" id="kuota-rows">
              <div class="kuota-row">
                <div class="kuota-row-field">
                  <label>Program Studi</label>
                  <select class="form-input" onchange="validateKuotaRow()">
                    <option value="">Pilih...</option>
                    <option value="PAI">Pendidikan Agama Islam (PAI)</option>
                    <option value="PBA">Pendidikan Bahasa Arab (PBA)</option>
                    <option value="PGMI">PGMI</option>
                    <option value="PG Paud">PG PAUD</option>
                  </select>
                </div>
                <div class="kuota-row-field">
                  <label>Kuota</label>
                  <input
                    type="number"
                    class="form-input"
                    min="1"
                    placeholder="1"
                  />
                </div>
                <div class="kuota-row-field">
                  <label>Syarat Min IPK</label>
                  <input
                    type="number"
                    class="form-input"
                    min="0"
                    max="4"
                    step="0.01"
                    placeholder="Opsional"
                  />
                </div>
                <button
                  class="kuota-row-delete"
                  onclick="deleteKuotaRow(this)"
                  style="visibility: hidden"
                >
                  ×
                </button>
              </div>
            </div>
            <button
              type="button"
              class="add-kuota-row-btn"
              onclick="addKuotaRow()"
            >
              + Tambah Baris Kuota
            </button>
          </div>
        </div>
        <div class="drawer-footer">
          <button class="btn btn-outline" onclick="closeAddSekolahDrawer()">
            Batal
          </button>
          <button class="btn btn-primary" onclick="saveAddSekolah()">
            Simpan
          </button>
        </div>
      </div>
    </div>

    <!-- Drawer: Edit Kuota -->
    <div
      class="drawer-overlay"
      id="edit-kuota-drawer-overlay"
      onclick="closeEditKuotaDrawer(event)"
    >
      <div class="drawer" onclick="event.stopPropagation()">
        <div class="drawer-header">
          <h2>Edit Kuota Sekolah</h2>
          <button class="drawer-close" onclick="closeEditKuotaDrawer()">
            ✕
          </button>
        </div>
        <div class="drawer-content">
          <!-- School Info (Read-only) -->
          <div class="form-group">
            <label class="form-label">Nama Sekolah</label>
            <input
              type="text"
              class="form-input"
              id="edit-sekolah-nama"
              readonly
              style="background: #f9fafb; cursor: not-allowed"
            />
          </div>
          <div class="form-group">
            <label class="form-label">NPSN</label>
            <input
              type="text"
              class="form-input"
              id="edit-sekolah-npsn"
              readonly
              style="background: #f9fafb; cursor: not-allowed"
            />
          </div>
          <div class="form-group">
            <label class="form-label">Jenjang</label>
            <input
              type="text"
              class="form-input"
              id="edit-sekolah-jenjang"
              readonly
              style="background: #f9fafb; cursor: not-allowed"
            />
          </div>

          <!-- Kuota Rows -->
          <div class="form-group">
            <label class="form-label">Kuota Program Studi *</label>
            <div class="kuota-rows" id="edit-kuota-rows">
              <!-- Akan diisi saat drawer dibuka -->
            </div>
            <button
              type="button"
              class="add-kuota-row-btn"
              onclick="addEditKuotaRow()"
            >
              + Tambah Baris Kuota
            </button>
          </div>
        </div>
        <div class="drawer-footer">
          <button class="btn btn-outline" onclick="closeEditKuotaDrawer()">
            Batal
          </button>
          <button class="btn btn-primary" onclick="saveEditKuota()">
            Simpan
          </button>
        </div>
      </div>
    </div>

    <!-- Modal: Konfirmasi Cabut Sekolah -->
    <div
      class="overlay"
      id="confirm-cabut-overlay"
      onclick="closeConfirmCabut(event)"
    >
      <div
        class="modal"
        onclick="event.stopPropagation()"
        style="max-width: 400px"
      >
        <div class="modal-head">
          <h2 style="font-size: 1rem; font-weight: 600">
            Konfirmasi Cabut Sekolah
          </h2>
          <button
            onclick="closeConfirmCabut()"
            style="
              background: none;
              border: none;
              cursor: pointer;
              font-size: 1.25rem;
              color: var(--text-muted);
            "
          >
            ✕
          </button>
        </div>
        <div class="confirm-modal-text">
          Apakah Anda yakin ingin mencabut
          <strong id="confirm-sekolah-nama">nama sekolah</strong> sebagai
          sekolah mitra?
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end">
          <button class="btn btn-outline" onclick="closeConfirmCabut()">
            Batal
          </button>
          <button
            class="btn btn-primary"
            style="background: var(--danger); border-color: var(--danger)"
            onclick="confirmCabut()"
          >
            Cabut
          </button>
        </div>
      </div>
    </div>

    <!-- Modal -->
    <div class="overlay" id="modal-overlay" onclick="closeModal(event)">
      <div
        class="modal"
        onclick="event.stopPropagation()"
        style="max-width: 640px; max-height: 95vh"
      >
        <div class="modal-head">
          <h2 style="font-size: 1rem; font-weight: 600">
            Buat Periode PPL Baru
          </h2>
          <button
            onclick="closeModal()"
            style="
              background: none;
              border: none;
              cursor: pointer;
              font-size: 1.25rem;
              color: var(--text-muted);
            "
          >
            ✕
          </button>
        </div>
        <form id="period-form" onsubmit="submitPeriod(event)">
          <!-- Nama Periode -->
          <div class="form-group">
            <label class="form-label">Nama Periode *</label>
            <input
              class="form-input"
              id="field-name"
              type="text"
              placeholder="Contoh: PPL Ganjil 2026/2027"
              required
            />
          </div>

          <!-- Jenis PPL -->
          <div class="form-group">
            <label
              class="form-label"
              style="display: flex; justify-content: space-between"
            >
              Jenis
              <button
                type="button"
                class="btn btn-link"
                onclick="openPPLTypeModal()"
                style="padding: 0; font-size: 0.75rem; color: var(--primary)"
              >
                + Kelola Jenis
              </button>
            </label>
            <div style="display: flex; gap: 0.5rem">
              <select
                class="form-input"
                id="field-ppl-type"
                style="flex: 1"
                required
                onchange="onPPLTypeChange()"
              >
                <option value="">Pilih jenis PPL…</option>
                <option value="PPL-PLP Internasional">
                  PPL-PLP Internasional
                </option>
                <option value="PPL-PLP Reguler">PPL-PLP Reguler</option>
              </select>
            </div>
          </div>

          <!-- Rentang Waktu Periode -->
          <div class="form-group">
            <label class="form-label">Rentang Waktu Periode *</label>
            <div class="date-pair">
              <input
                class="form-input"
                id="field-start-date"
                type="date"
                required
              />
              <input
                class="form-input"
                id="field-end-date"
                type="date"
                required
              />
            </div>
          </div>

          <!-- Milestone Section -->
          <div class="form-group">
            <label
              class="form-label"
              style="
                display: flex;
                justify-content: space-between;
                align-items: center;
              "
            >
              Milestone *
              <button
                type="button"
                class="btn btn-link"
                onclick="addMilestone()"
                style="padding: 0; font-size: 0.75rem; color: var(--primary)"
              >
                + Tambah
              </button>
            </label>
            <div
              id="milestones-list"
              style="
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                margin-bottom: 0.75rem;
              "
            ></div>
            <div
              class="text-sm text-muted"
              id="milestone-error"
              style="color: var(--danger); display: none"
            ></div>
          </div>

          <!-- Registration Requirements -->
          <div class="form-group">
            <label
              style="
                display: flex;
                align-items: center;
                gap: 0.5rem;
                cursor: pointer;
                margin-bottom: 0.75rem;
              "
            >
              <input
                type="checkbox"
                id="field-has-requirements"
                onchange="toggleRequirementsEditor()"
              />
              <span class="form-label" style="margin: 0"
                >Terdapat Upload Syarat Pendaftaran</span
              >
            </label>
          </div>

          <!-- Requirements Editor -->
          <div
            class="form-group"
            id="requirements-editor-section"
            style="display: none"
          >
            <label class="form-label">Syarat Pendaftaran</label>
            <div
              id="editor-js"
              style="
                background: white;
                border: 1px solid var(--border);
                border-radius: 0.5rem;
                padding: 1rem;
                min-height: 200px;
                max-height: 300px;
                overflow-y: auto;
              "
            ></div>
            <input type="hidden" id="field-requirements-json" />
          </div>

          <!-- Mata Kuliah Prasyarat Section -->
          <div class="form-group">
            <label class="form-label">Mata Kuliah Prasyarat</label>

            <!-- Empty state -->
            <div
              id="prerequisites-empty"
              style="
                text-align: center;
                padding: 1.5rem;
                color: var(--text-muted);
                font-size: 0.875rem;
              "
            >
              Pilih jenis PPL terlebih dahulu untuk melihat mata kuliah
              prasyarat per program studi
            </div>

            <!-- Loading state -->
            <div
              id="prerequisites-loading"
              style="
                text-align: center;
                padding: 1.5rem;
                color: var(--text-muted);
                display: none;
              "
            >
              ⏳ Memuat data prasyarat...
            </div>

            <!-- Prerequisites container -->
            <div id="prerequisites-container" style="display: none">
              <!-- Info message -->
              <div class="prerequisites-info">
                ℹ️ Atur mata kuliah prasyarat yang diperlukan untuk setiap
                program studi. Ubah jenis PPL untuk memuat default prasyarat.
              </div>

              <!-- Select all -->
              <div class="prerequisites-select-all">
                <input
                  type="checkbox"
                  id="select-all-programs"
                  onchange="toggleAllPrograms(this)"
                />
                <label for="select-all-programs"
                  >Centang semua program studi</label
                >
              </div>

              <!-- Programs list -->
              <div id="study-programs-list"></div>

              <!-- Set as default checkbox -->
              <div class="set-default-checkbox-group">
                <input type="checkbox" id="set-default-checkbox" disabled />
                <label for="set-default-checkbox" id="set-default-label">
                  Atur sebagai default mata kuliah prasyarat untuk jenis PPL
                </label>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div
            style="
              margin-top: 1.5rem;
              display: flex;
              justify-content: flex-end;
              gap: 0.5rem;
            "
          >
            <button
              type="button"
              class="btn btn-outline"
              onclick="closeModal()"
            >
              Batal
            </button>
            <button type="submit" class="btn btn-primary">
              Simpan Periode
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- PPL Type Management Modal -->
    <div
      class="overlay"
      id="ppl-type-modal-overlay"
      onclick="closePPLTypeModal(event)"
    >
      <div
        class="modal"
        onclick="event.stopPropagation()"
        style="max-width: 500px"
      >
        <div class="modal-head">
          <h2 style="font-size: 1rem; font-weight: 600">Kelola Jenis PPL</h2>
          <button
            onclick="closePPLTypeModal()"
            style="
              background: none;
              border: none;
              cursor: pointer;
              font-size: 1.25rem;
              color: var(--text-muted);
            "
          >
            ✕
          </button>
        </div>

        <div class="form-group">
          <label class="form-label">Jenis PPL Baru</label>
          <div style="display: flex; gap: 0.5rem">
            <input
              class="form-input"
              id="new-ppl-type-input"
              type="text"
              placeholder="Nama jenis PPL…"
              style="flex: 1"
            />
            <button
              type="button"
              class="btn btn-primary"
              onclick="createPPLType()"
            >
              Buat
            </button>
          </div>
        </div>

        <div style="max-height: 300px; overflow-y: auto">
          <div class="text-sm text-muted" style="margin-bottom: 0.75rem">
            Jenis PPL yang terdaftar:
          </div>
          <div
            id="ppl-types-list"
            style="display: flex; flex-direction: column; gap: 0.5rem"
          >
            <div class="ppl-type-item">PPL-PLP Internasional</div>
            <div class="ppl-type-item">PPL-PLP Reguler</div>
          </div>
        </div>

        <div
          style="margin-top: 1.25rem; display: flex; justify-content: flex-end"
        >
          <button
            type="button"
            class="btn btn-outline"
            onclick="closePPLTypeModal()"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@editorjs/editorjs@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@editorjs/header@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@editorjs/list@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@editorjs/quote@latest"></script>

    <script>
      const dtabs = document.querySelectorAll(".dtab");
      const dtabPanels = document.querySelectorAll(".dtab-panel");
      let pplTypes = [
        {
          id: "1",
          name: "PPL-PLP Internasional",
        },
        {
          id: "2",
          name: "PPL-PLP Reguler",
        },
      ];
      let editor = null;
      let milestones = [];

      function switchDTab(i) {
        dtabs.forEach((t) => t.classList.remove("active"));
        dtabPanels.forEach((p) => p.classList.remove("active"));
        dtabs[i].classList.add("active");
        dtabPanels[i].classList.add("active");
      }

      function showDetail(name) {
        document.getElementById("view-list").classList.remove("active");
        document.getElementById("view-detail").classList.add("active");
        document.getElementById("btn-back").style.display = "inline";
        document.getElementById("page-title").textContent = name;
        document.getElementById("detail-name").textContent = name;
      }

      function showList() {
        document.getElementById("view-detail").classList.remove("active");
        document.getElementById("view-list").classList.add("active");
        document.getElementById("btn-back").style.display = "none";
        document.getElementById("page-title").textContent = "Periode PPL";
      }

      function openModal() {
        document.getElementById("modal-overlay").classList.add("open");
        initializeForm();
      }

      function closeModal(e) {
        if (!e || e.target === document.getElementById("modal-overlay"))
          document.getElementById("modal-overlay").classList.remove("open");
      }

      function openPPLTypeModal() {
        document.getElementById("ppl-type-modal-overlay").classList.add("open");
        renderPPLTypesList();
      }

      function closePPLTypeModal(e) {
        if (
          !e ||
          e.target === document.getElementById("ppl-type-modal-overlay")
        )
          document
            .getElementById("ppl-type-modal-overlay")
            .classList.remove("open");
      }

      // API Functions (Mocked)
      function loadPPLTypes() {
        renderPPLTypeSelect();
        renderPPLTypesList();
      }

      function createPPLType() {
        const input = document.getElementById("new-ppl-type-input");
        const name = input.value.trim();

        if (!name) {
          alert("Nama jenis PPL tidak boleh kosong");
          return;
        }

        // Mock: Add new type
        const newType = {
          id: String(pplTypes.length + 1),
          name: name,
        };
        pplTypes.push(newType);
        input.value = "";
        renderPPLTypeSelect();
        renderPPLTypesList();
        document.getElementById("field-ppl-type").value = newType.id;
        showSuccessDialog("Jenis PPL berhasil dibuat");
      }

      function deletePPLType(id) {
        if (!confirm("Apakah Anda yakin ingin menghapus jenis PPL ini?"))
          return;

        // Mock: Remove type
        pplTypes = pplTypes.filter((t) => t.id !== id);
        renderPPLTypeSelect();
        renderPPLTypesList();
        showSuccessDialog("Jenis PPL berhasil dihapus");
      }

      function renderPPLTypeSelect() {
        const select = document.getElementById("field-ppl-type");
        const currentValue = select.value;
        select.innerHTML = '<option value="">Pilih jenis PPL…</option>';
        pplTypes.forEach((type) => {
          const option = document.createElement("option");
          option.value = type.id;
          option.textContent = type.name;
          select.appendChild(option);
        });
        if (currentValue) select.value = currentValue;
      }

      function renderPPLTypesList() {
        const list = document.getElementById("ppl-types-list");
        list.innerHTML = "";
        pplTypes.forEach((type) => {
          const item = document.createElement("div");
          item.style.cssText =
            "display:flex;justify-content:space-between;align-items:center;padding:0.75rem;background:#f9fafb;border-radius:0.5rem";
          item.innerHTML = `
            <span>${type.name}</span>
            <button type="button" class="btn btn-outline" style="padding:0.25rem 0.625rem;font-size:0.75rem" onclick="deletePPLType('${type.id}')">Hapus</button>
          `;
          list.appendChild(item);
        });
      }

      // Form Functions
      function initializeForm() {
        document.getElementById("period-form").reset();
        milestones = [
          {
            title: "Pendaftaran",
            start_date: "",
            end_date: "",
            is_default: true,
          },
        ];
        renderMilestones();
        loadPPLTypes();
        document.getElementById("field-has-requirements").checked = false;
        document.getElementById("requirements-editor-section").style.display =
          "none";
        if (editor) editor.destroy();
        editor = null;

        // Reset prerequisites section
        document.getElementById("prerequisites-container").style.display =
          "none";
        document.getElementById("prerequisites-empty").style.display = "block";
        document.getElementById("prerequisites-loading").style.display = "none";
        document.getElementById("study-programs-list").innerHTML = "";
        document.getElementById("set-default-btn").disabled = true;
      }

      function toggleRequirementsEditor() {
        const hasReq = document.getElementById(
          "field-has-requirements",
        ).checked;
        const section = document.getElementById("requirements-editor-section");
        section.style.display = hasReq ? "block" : "none";
        if (hasReq && !editor) {
          initializeEditor();
        }
      }

      // Prerequisites Functions
      function onPPLTypeChange() {
        const pplTypeId = document.getElementById("field-ppl-type").value;
        const container = document.getElementById("prerequisites-container");
        const emptyState = document.getElementById("prerequisites-empty");
        const loading = document.getElementById("prerequisites-loading");

        if (!pplTypeId) {
          container.style.display = "none";
          emptyState.style.display = "block";
          return;
        }

        // Show loading state
        loading.style.display = "block";
        container.style.display = "none";
        emptyState.style.display = "none";

        // Simulate API call to GET /ppl-types/{ppl_type_id}/default-prerequisites
        setTimeout(() => {
          loadPrerequisites(pplTypeId);
          loading.style.display = "none";
          container.style.display = "block";
        }, 500);
      }

      function loadPrerequisites(pplTypeId) {
        // Mock data: load default prerequisites for the PPL type
        const mockDefaultPrerequisites = {
          1: [
            {
              study_program_id: "sp-001",
              study_program_name: "Pendidikan Matematika",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [
                {
                  course_code: "MAT101",
                  type: "completed",
                  minimum_grade: "B",
                },
                {
                  course_code: "PPL-MAT-2024",
                  type: "enrolled",
                  minimum_grade: null,
                },
              ],
            },
            {
              study_program_id: "sp-002",
              study_program_name: "Pendidikan IPA",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [],
            },
            {
              study_program_id: "sp-003",
              study_program_name: "Pendidikan Agama Islam (PAI)",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [
                {
                  course_code: "PAI101",
                  type: "completed",
                  minimum_grade: "A",
                },
              ],
            },
          ],
          2: [
            {
              study_program_id: "sp-001",
              study_program_name: "Pendidikan Matematika",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [],
            },
            {
              study_program_id: "sp-002",
              study_program_name: "Pendidikan IPA",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [
                {
                  course_code: "IPA101",
                  type: "completed",
                  minimum_grade: "B",
                },
                {
                  course_code: "IPA102",
                  type: "enrolled",
                  minimum_grade: null,
                },
              ],
            },
            {
              study_program_id: "sp-003",
              study_program_name: "Pendidikan Agama Islam (PAI)",
              department_name: "Fakutas Tarbiyah dan Keguruan",
              courses: [],
            },
          ],
        };

        const prerequisites = mockDefaultPrerequisites[pplTypeId] || [];
        renderPrerequisitesV2(prerequisites, pplTypeId);
      }

      // ============================================================================
      // PREREQUISITES TABLE RENDERING
      // ============================================================================

      // State: { programId -> { checked, courses: [{course_code, type, minimum_grade}] } }
      let prereqState = {};

      function renderPrerequisitesV2(prerequisites, pplTypeId) {
        // Build initial state from loaded data
        prereqState = {};
        prerequisites.forEach((p) => {
          prereqState[p.study_program_id] = {
            name: p.study_program_name,
            checked: p.courses && p.courses.length > 0,
            courses:
              p.courses && p.courses.length > 0
                ? p.courses.map((c) => ({
                    course_code: c.course_code || "",
                    type: c.type || "",
                    minimum_grade: c.minimum_grade || "",
                  }))
                : [],
          };
        });

        rebuildTable(prerequisites);
        updateSetDefaultLabel(pplTypeId);
        updateSelectAllState();
      }

      function rebuildTable(programList) {
        const container = document.getElementById("study-programs-list");
        container.innerHTML = "";

        const table = document.createElement("table");
        table.className = "prereq-table";

        // Header
        table.innerHTML = `
          <thead>
            <tr>
              <th style="width:44px"></th>
              <th>Program Studi</th>
              <th>Kode Mata Kuliah</th>
              <th>Tipe Prasyarat</th>
              <th>Nilai Minimum</th>
              <th style="width:56px"></th>
            </tr>
          </thead>
        `;

        const tbody = document.createElement("tbody");

        programList.forEach((program) => {
          const pid = program.study_program_id;
          const state = prereqState[pid];
          const courses = state.courses;
          const isChecked = state.checked;

          if (courses.length === 0) {
            // Single row: empty state
            const tr = document.createElement("tr");
            tr.dataset.programId = pid;
            tr.className = "prereq-row";
            if (!isChecked) tr.classList.add("prereq-row--unchecked");

            tr.innerHTML = `
              <td class="prereq-td prereq-td--checkbox" rowspan="1">
                <input type="checkbox" class="prereq-program-cb" data-program-id="${pid}" ${isChecked ? "checked" : ""}>
              </td>
              <td class="prereq-td prereq-td--name" rowspan="1">${program.study_program_name}</td>
              <td class="prereq-td prereq-td--empty" colspan="4">
                <span class="prereq-empty-msg">Belum ada mata kuliah prasyarat</span>
                <button type="button" class="prereq-add-btn" data-program-id="${pid}">+ Tambah</button>
              </td>
            `;

            tr.querySelector(".prereq-program-cb").onchange = (e) =>
              onProgramCbChange(pid, e.target.checked);
            tr.querySelector(".prereq-add-btn").onclick = () =>
              addCourseToProgram(pid);
            tbody.appendChild(tr);
          } else {
            courses.forEach((course, idx) => {
              const tr = buildCourseRow(
                pid,
                program.study_program_name,
                idx,
                course,
                courses.length,
                isChecked,
              );
              tbody.appendChild(tr);
            });

            // Add button row
            const addTr = document.createElement("tr");
            addTr.dataset.programId = pid;
            addTr.dataset.rowType = "add";
            addTr.className = "prereq-row prereq-row--add";
            if (!isChecked) addTr.classList.add("prereq-row--unchecked");
            addTr.innerHTML = `<td colspan="6" style="padding:0.25rem 0.75rem">
              <button type="button" class="prereq-add-btn" data-program-id="${pid}">+ Tambah Mata Kuliah</button>
            </td>`;
            addTr.querySelector(".prereq-add-btn").onclick = () =>
              addCourseToProgram(pid);
            tbody.appendChild(addTr);
          }
        });

        table.appendChild(tbody);
        container.appendChild(table);
      }

      function buildCourseRow(
        pid,
        programName,
        idx,
        course,
        totalCourses,
        isChecked,
      ) {
        const tr = document.createElement("tr");
        tr.dataset.programId = pid;
        tr.dataset.courseIndex = String(idx);
        tr.className = "prereq-row";
        if (!isChecked) tr.classList.add("prereq-row--unchecked");

        // Col 1: checkbox (rowspan, only on first row)
        if (idx === 0) {
          const tdCb = document.createElement("td");
          tdCb.className = "prereq-td prereq-td--checkbox";
          tdCb.rowSpan = totalCourses + 1; // +1 for add-btn row
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.className = "prereq-program-cb";
          cb.dataset.programId = pid;
          cb.checked = isChecked;
          cb.onchange = (e) => onProgramCbChange(pid, e.target.checked);
          tdCb.appendChild(cb);
          tr.appendChild(tdCb);
        }

        // Col 2: program name (rowspan, only on first row)
        if (idx === 0) {
          const tdName = document.createElement("td");
          tdName.className = "prereq-td prereq-td--name";
          tdName.rowSpan = totalCourses + 1;
          tdName.textContent = programName;
          tr.appendChild(tdName);
        }

        // Col 3: course code
        const tdCode = document.createElement("td");
        tdCode.className = "prereq-td";
        const codeInput = document.createElement("input");
        codeInput.type = "text";
        codeInput.className = "form-input prereq-input";
        codeInput.placeholder = "Contoh: MAT101";
        codeInput.value = course.course_code || "";
        codeInput.dataset.field = "course_code";
        tdCode.appendChild(codeInput);
        tr.appendChild(tdCode);

        // Col 4: type
        const tdType = document.createElement("td");
        tdType.className = "prereq-td";
        const typeSelect = document.createElement("select");
        typeSelect.className = "form-input prereq-input";
        typeSelect.dataset.field = "type";
        typeSelect.innerHTML = `
          <option value="">Pilih…</option>
          <option value="completed" ${course.type === "completed" ? "selected" : ""}>Completed</option>
          <option value="enrolled" ${course.type === "enrolled" ? "selected" : ""}>Enrolled</option>
        `;
        typeSelect.onchange = () => onTypeChange(tr, typeSelect.value);
        tdType.appendChild(typeSelect);
        tr.appendChild(tdType);

        // Col 5: minimum grade
        const tdGrade = document.createElement("td");
        tdGrade.className = "prereq-td";
        const gradeSelect = document.createElement("select");
        gradeSelect.className = "form-input prereq-input";
        gradeSelect.dataset.field = "minimum_grade";
        gradeSelect.innerHTML = `
          <option value="">Pilih…</option>
          <option value="A" ${course.minimum_grade === "A" ? "selected" : ""}>A</option>
          <option value="B" ${course.minimum_grade === "B" ? "selected" : ""}>B</option>
          <option value="C" ${course.minimum_grade === "C" ? "selected" : ""}>C</option>
          <option value="D" ${course.minimum_grade === "D" ? "selected" : ""}>D</option>
          <option value="E" ${course.minimum_grade === "E" ? "selected" : ""}>E</option>
        `;
        if (course.type !== "completed") {
          gradeSelect.style.visibility = "hidden";
        }
        tdGrade.appendChild(gradeSelect);
        tr.appendChild(tdGrade);

        // Col 6: delete
        const tdDel = document.createElement("td");
        tdDel.className = "prereq-td prereq-td--action";
        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "prereq-del-btn";
        delBtn.textContent = "×";
        delBtn.onclick = () => deleteCourseFromProgram(pid, idx);
        tdDel.appendChild(delBtn);
        tr.appendChild(tdDel);

        return tr;
      }

      function onTypeChange(tr, typeValue) {
        const gradeSelect = tr.querySelector('[data-field="minimum_grade"]');
        if (typeValue === "completed") {
          gradeSelect.style.visibility = "";
        } else {
          gradeSelect.style.visibility = "hidden";
          gradeSelect.value = "";
        }
      }

      function onProgramCbChange(pid, isChecked) {
        prereqState[pid].checked = isChecked;
        const table = document.querySelector(".prereq-table");
        table.querySelectorAll(`tr[data-program-id="${pid}"]`).forEach((tr) => {
          if (isChecked) {
            tr.classList.remove("prereq-row--unchecked");
          } else {
            tr.classList.add("prereq-row--unchecked");
          }
        });
        updateSelectAllState();
      }

      function addCourseToProgram(pid) {
        const programList = Object.keys(prereqState).map((id) => ({
          study_program_id: id,
          study_program_name: prereqState[id].name,
        }));

        // Save current input values back to state
        syncStateFromTable();

        prereqState[pid].courses.push({
          course_code: "",
          type: "",
          minimum_grade: "",
        });
        prereqState[pid].checked = true;

        rebuildTable(programList);
        updateSelectAllState();
      }

      function deleteCourseFromProgram(pid, idx) {
        syncStateFromTable();
        prereqState[pid].courses.splice(idx, 1);

        const programList = Object.keys(prereqState).map((id) => ({
          study_program_id: id,
          study_program_name: prereqState[id].name,
        }));
        rebuildTable(programList);
        updateSelectAllState();
      }

      function syncStateFromTable() {
        const table = document.querySelector(".prereq-table");
        if (!table) return;

        Object.keys(prereqState).forEach((pid) => {
          const courseRows = Array.from(
            table.querySelectorAll(
              `tr[data-program-id="${pid}"][data-course-index]`,
            ),
          );
          if (courseRows.length > 0) {
            prereqState[pid].courses = courseRows.map((tr) => ({
              course_code:
                tr.querySelector('[data-field="course_code"]')?.value || "",
              type: tr.querySelector('[data-field="type"]')?.value || "",
              minimum_grade:
                tr.querySelector('[data-field="minimum_grade"]')?.value || "",
            }));
          }
          const cb = table.querySelector(
            `.prereq-program-cb[data-program-id="${pid}"]`,
          );
          if (cb) prereqState[pid].checked = cb.checked;
        });
      }

      function toggleAllPrograms(checkbox) {
        syncStateFromTable();
        Object.keys(prereqState).forEach((pid) => {
          prereqState[pid].checked = checkbox.checked;
        });
        document.querySelectorAll(".prereq-program-cb").forEach((cb) => {
          cb.checked = checkbox.checked;
          onProgramCbChange(cb.dataset.programId, checkbox.checked);
        });
        updateSelectAllState();
      }

      function updateSelectAllState() {
        const selectAllBtn = document.getElementById("select-all-programs");
        const cbs = document.querySelectorAll(".prereq-program-cb");
        if (cbs.length === 0) {
          selectAllBtn.indeterminate = false;
          selectAllBtn.checked = false;
          return;
        }
        const checkedCount = Array.from(cbs).filter((cb) => cb.checked).length;
        if (checkedCount === 0) {
          selectAllBtn.indeterminate = false;
          selectAllBtn.checked = false;
        } else if (checkedCount === cbs.length) {
          selectAllBtn.indeterminate = false;
          selectAllBtn.checked = true;
        } else {
          selectAllBtn.indeterminate = true;
        }
      }

      function updateSetDefaultLabel(pplTypeId) {
        const setDefaultCheckbox = document.getElementById(
          "set-default-checkbox",
        );
        const setDefaultLabel = document.getElementById("set-default-label");
        const selectedPPLType = pplTypes.find((t) => t.id === pplTypeId);

        setDefaultCheckbox.disabled = !pplTypeId;

        if (selectedPPLType) {
          setDefaultLabel.textContent = `Atur sebagai default mata kuliah prasyarat untuk "${selectedPPLType.name}" mendatang`;
        } else {
          setDefaultLabel.textContent =
            "Atur sebagai default mata kuliah prasyarat untuk jenis PPL";
        }
      }

      function collectPrerequisitesDataV2() {
        syncStateFromTable();
        const data = [];
        Object.keys(prereqState).forEach((pid) => {
          const s = prereqState[pid];
          if (!s.checked) return;
          const courses = s.courses
            .filter((c) => c.course_code && c.type)
            .map((c) => {
              const obj = { course_code: c.course_code, type: c.type };
              if (c.type === "completed" && c.minimum_grade)
                obj.minimum_grade = c.minimum_grade;
              return obj;
            });
          if (courses.length > 0) {
            data.push({ study_program_id: pid, courses });
          }
        });
        return data;
      }

      function validatePrerequisitesV2() {
        syncStateFromTable();
        const errors = [];
        Object.keys(prereqState).forEach((pid) => {
          const s = prereqState[pid];
          if (!s.checked) return;
          const seen = new Set();
          s.courses.forEach((c, idx) => {
            if (!c.course_code)
              errors.push(
                `${s.name}: kode mata kuliah baris ${idx + 1} kosong`,
              );
            if (!c.type)
              errors.push(
                `${s.name}: tipe prasyarat baris ${idx + 1} belum dipilih`,
              );
            if (c.type === "completed" && !c.minimum_grade)
              errors.push(
                `${s.name}: nilai minimum baris ${idx + 1} belum dipilih`,
              );
            if (c.course_code && seen.has(c.course_code))
              errors.push(`${s.name}: kode "${c.course_code}" duplikat`);
            if (c.course_code) seen.add(c.course_code);
          });
        });
        if (errors.length > 0) console.error("Prerequisite errors:", errors);
        return errors.length === 0;
      }

      // ============================================================================
      // END PREREQUISITES TABLE RENDERING
      // ============================================================================

      function renderPrerequisites(prerequisites, pplTypeId) {
        const list = document.getElementById("study-programs-list");
        list.innerHTML = "";

        const table = document.createElement("table");
        table.className = "prerequisites-table";

        const thead = document.createElement("thead");
        const headerRow = document.createElement("tr");
        headerRow.innerHTML = `
          <th style="width: 20%">Program Studi</th>
          <th style="width: 30%">Kode Mata Kuliah</th>
          <th style="width: 20%">Tipe Prasyarat</th>
          <th style="width: 20%">Nilai Minimum</th>
          <th style="width: 10%; text-align: center">Aksi</th>
        `;
        thead.appendChild(headerRow);
        table.appendChild(thead);

        const tbody = document.createElement("tbody");

        prerequisites.forEach((program) => {
          const courses =
            program.courses && program.courses.length > 0
              ? program.courses
              : [{ course_code: "", prerequisite_type: "", minimum_grade: "" }];

          courses.forEach((course, courseIdx) => {
            const row = document.createElement("tr");
            row.id = `program-row-${program.study_program_id}-${courseIdx}`;

            // Program name cell — show name only on first row, blank on subsequent
            const programCell = document.createElement("td");
            programCell.className = "program-name-cell";
            programCell.dataset.programId = program.study_program_id;
            if (courseIdx === 0) {
              programCell.textContent = program.study_program_name;
            }
            row.appendChild(programCell);

            // Course code cell
            const courseCell = document.createElement("td");
            courseCell.className = "course-cell";

            const courseInputGroup = document.createElement("div");
            courseInputGroup.className = "course-input-group";

            const courseInput = document.createElement("input");
            courseInput.type = "text";
            courseInput.className = "form-input";
            courseInput.placeholder = "Contoh: MAT101";
            courseInput.value = course.course_code || "";
            courseInput.dataset.programId = program.study_program_id;
            courseInput.dataset.index = courseIdx;
            courseInput.style.fontSize = "0.875rem";

            const courseError = document.createElement("div");
            courseError.className = "course-error";
            courseError.textContent = "Kode tidak boleh kosong";

            courseInputGroup.appendChild(courseInput);
            courseInputGroup.appendChild(courseError);
            courseCell.appendChild(courseInputGroup);

            // Prerequisite type cell
            const typeCell = document.createElement("td");
            typeCell.className = "course-cell";

            const typeInputGroup = document.createElement("div");
            typeInputGroup.className = "course-input-group";

            const typeSelect = document.createElement("select");
            typeSelect.className = "form-input";
            typeSelect.dataset.programId = program.study_program_id;
            typeSelect.dataset.index = courseIdx;
            typeSelect.style.fontSize = "0.875rem";
            typeSelect.onchange = function () {
              toggleGradeField(program.study_program_id, courseIdx, this.value);
            };

            const typeOptions = [
              { value: "", label: "Pilih…" },
              { value: "completed", label: "Completed" },
              { value: "enrolled", label: "Enrolled" },
            ];
            typeOptions.forEach((opt) => {
              const optEl = document.createElement("option");
              optEl.value = opt.value;
              optEl.textContent = opt.label;
              if (opt.value === (course.prerequisite_type || ""))
                optEl.selected = true;
              typeSelect.appendChild(optEl);
            });

            const typeError = document.createElement("div");
            typeError.className = "course-error";
            typeError.textContent = "Harus dipilih";

            typeInputGroup.appendChild(typeSelect);
            typeInputGroup.appendChild(typeError);
            typeCell.appendChild(typeInputGroup);

            // Grade cell
            const gradeCell = document.createElement("td");
            gradeCell.className = "course-cell";
            gradeCell.id = `grade-cell-${program.study_program_id}-${courseIdx}`;

            const gradeInputGroup = document.createElement("div");
            gradeInputGroup.className = "course-input-group";

            const gradeSelect = document.createElement("select");
            gradeSelect.className = "form-input";
            gradeSelect.dataset.programId = program.study_program_id;
            gradeSelect.dataset.index = courseIdx;
            gradeSelect.style.fontSize = "0.875rem";
            gradeSelect.id = `grade-select-${program.study_program_id}-${courseIdx}`;

            const options = ["", "A", "B", "C", "D", "E"];
            options.forEach((opt) => {
              const optEl = document.createElement("option");
              optEl.value = opt;
              optEl.textContent = opt || "Pilih…";
              if (opt === course.minimum_grade) optEl.selected = true;
              gradeSelect.appendChild(optEl);
            });

            const gradeError = document.createElement("div");
            gradeError.className = "course-error";
            gradeError.textContent = "Harus dipilih";

            gradeInputGroup.appendChild(gradeSelect);
            gradeInputGroup.appendChild(gradeError);
            gradeCell.appendChild(gradeInputGroup);

            // Hide grade field if type is "enrolled"
            if (course.prerequisite_type === "enrolled") {
              gradeCell.classList.add("prerequisite-type-hidden");
              gradeSelect.disabled = true;
            }

            // Action cell
            const actionCell = document.createElement("td");
            actionCell.style.textAlign = "center";

            const deleteBtn = document.createElement("button");
            deleteBtn.type = "button";
            deleteBtn.className = "delete-prereq-btn";
            deleteBtn.textContent = "✕";
            deleteBtn.onclick = (e) => {
              e.preventDefault();
              removeCourseRow(program.study_program_id, courseIdx);
            };

            actionCell.appendChild(deleteBtn);

            row.appendChild(courseCell);
            row.appendChild(typeCell);
            row.appendChild(gradeCell);
            row.appendChild(actionCell);
            tbody.appendChild(row);
          });

          // Add button row
          const addRow = document.createElement("tr");
          addRow.id = `add-row-${program.study_program_id}`;
          addRow.dataset.programName = program.study_program_name;
          const addCell = document.createElement("td");
          addCell.colSpan = "4";
          addCell.style.padding = "0.375rem 0.625rem";

          const addBtn = document.createElement("button");
          addBtn.type = "button";
          addBtn.className = "add-course-btn";
          addBtn.textContent = "+ Tambah Mata Kuliah";
          addBtn.onclick = (e) => {
            e.preventDefault();
            addCourseRow(program.study_program_id);
          };

          addCell.appendChild(addBtn);
          addRow.appendChild(addCell);
          tbody.appendChild(addRow);
        });

        table.appendChild(tbody);
        list.appendChild(table);

        // Update the set default button
        const selectedPPLType = pplTypes.find((t) => t.id === pplTypeId);
        const setDefaultBtn = document.getElementById("set-default-btn");
        const buttonText =
          selectedPPLType && selectedPPLType.name
            ? `Atur sebagai default mata kuliah prasyarat untuk ${selectedPPLType.name}`
            : "Atur sebagai default mata kuliah prasyarat untuk -";
        setDefaultBtn.textContent = buttonText;
        setDefaultBtn.disabled = false;
      }

      function toggleGradeField(programId, courseIdx, typeValue) {
        const gradeCell = document.getElementById(
          `grade-cell-${programId}-${courseIdx}`,
        );
        const gradeSelect = document.getElementById(
          `grade-select-${programId}-${courseIdx}`,
        );

        if (typeValue === "enrolled") {
          gradeCell.classList.add("prerequisite-type-hidden");
          gradeSelect.disabled = true;
          gradeSelect.value = "";
        } else if (typeValue === "completed") {
          gradeCell.classList.remove("prerequisite-type-hidden");
          gradeSelect.disabled = false;
        }
      }

      function addCourseRow(programId) {
        const table = document.querySelector(".prerequisites-table tbody");
        const addRow = document.getElementById(`add-row-${programId}`);

        const newIndex = Array.from(
          table.querySelectorAll(`tr[id^="program-row-${programId}"]`),
        ).length;

        const row = document.createElement("tr");
        row.id = `program-row-${programId}-${newIndex}`;

        // Program name cell — blank for non-first rows
        const programCell = document.createElement("td");
        programCell.className = "program-name-cell";
        programCell.dataset.programId = programId;
        row.appendChild(programCell);

        // Course code cell
        const courseCell = document.createElement("td");
        courseCell.className = "course-cell";

        const courseInputGroup = document.createElement("div");
        courseInputGroup.className = "course-input-group";

        const courseInput = document.createElement("input");
        courseInput.type = "text";
        courseInput.className = "form-input";
        courseInput.placeholder = "Contoh: MAT101";
        courseInput.dataset.programId = programId;
        courseInput.dataset.index = newIndex;
        courseInput.style.fontSize = "0.875rem";

        const courseError = document.createElement("div");
        courseError.className = "course-error";
        courseError.textContent = "Kode tidak boleh kosong";

        courseInputGroup.appendChild(courseInput);
        courseInputGroup.appendChild(courseError);
        courseCell.appendChild(courseInputGroup);

        // Prerequisite type cell
        const typeCell = document.createElement("td");
        typeCell.className = "course-cell";

        const typeInputGroup = document.createElement("div");
        typeInputGroup.className = "course-input-group";

        const typeSelect = document.createElement("select");
        typeSelect.className = "form-input";
        typeSelect.dataset.programId = programId;
        typeSelect.dataset.index = newIndex;
        typeSelect.style.fontSize = "0.875rem";
        typeSelect.onchange = function () {
          toggleGradeField(programId, newIndex, this.value);
        };

        const typeOptions = [
          { value: "", label: "Pilih…" },
          { value: "completed", label: "Completed" },
          { value: "enrolled", label: "Enrolled" },
        ];
        typeOptions.forEach((opt) => {
          const optEl = document.createElement("option");
          optEl.value = opt.value;
          optEl.textContent = opt.label;
          typeSelect.appendChild(optEl);
        });

        const typeError = document.createElement("div");
        typeError.className = "course-error";
        typeError.textContent = "Harus dipilih";

        typeInputGroup.appendChild(typeSelect);
        typeInputGroup.appendChild(typeError);
        typeCell.appendChild(typeInputGroup);

        // Grade cell
        const gradeCell = document.createElement("td");
        gradeCell.className = "course-cell";
        gradeCell.id = `grade-cell-${programId}-${newIndex}`;

        const gradeInputGroup = document.createElement("div");
        gradeInputGroup.className = "course-input-group";

        const gradeSelect = document.createElement("select");
        gradeSelect.className = "form-input";
        gradeSelect.dataset.programId = programId;
        gradeSelect.dataset.index = newIndex;
        gradeSelect.style.fontSize = "0.875rem";
        gradeSelect.id = `grade-select-${programId}-${newIndex}`;

        const options = ["", "A", "B", "C", "D", "E"];
        options.forEach((opt) => {
          const optEl = document.createElement("option");
          optEl.value = opt;
          optEl.textContent = opt || "Pilih…";
          gradeSelect.appendChild(optEl);
        });

        const gradeError = document.createElement("div");
        gradeError.className = "course-error";
        gradeError.textContent = "Harus dipilih";

        gradeInputGroup.appendChild(gradeSelect);
        gradeInputGroup.appendChild(gradeError);
        gradeCell.appendChild(gradeInputGroup);

        // Action cell
        const actionCell = document.createElement("td");
        actionCell.style.textAlign = "center";

        const deleteBtn = document.createElement("button");
        deleteBtn.type = "button";
        deleteBtn.className = "delete-prereq-btn";
        deleteBtn.textContent = "✕";
        deleteBtn.onclick = (e) => {
          e.preventDefault();
          removeCourseRow(programId, newIndex);
        };

        actionCell.appendChild(deleteBtn);

        row.appendChild(courseCell);
        row.appendChild(typeCell);
        row.appendChild(gradeCell);
        row.appendChild(actionCell);

        // Insert before add row
        addRow.parentNode.insertBefore(row, addRow);
      }

      function removeCourseRow(programId, index) {
        const row = document.getElementById(
          `program-row-${programId}-${index}`,
        );
        if (!row) return;

        const tbody = row.closest("tbody");
        const allRows = Array.from(
          tbody.querySelectorAll(`tr[id^="program-row-${programId}-"]`),
        );

        if (allRows.length <= 1) {
          // Hanya kosongkan value, jangan hapus row
          const courseInput = row.querySelector("input[type='text']");
          const gradeSelect = row.querySelector("select");
          if (courseInput) courseInput.value = "";
          if (gradeSelect) gradeSelect.value = "";
          return;
        }

        const wasFirst =
          row
            .querySelector(`.program-name-cell[data-program-id="${programId}"]`)
            ?.textContent.trim() !== "";
        row.remove();

        // Jika row yang dihapus adalah row pertama, pindahkan nama prodi ke row berikutnya
        if (wasFirst) {
          const firstRemaining = tbody.querySelector(
            `tr[id^="program-row-${programId}-"]`,
          );
          if (firstRemaining) {
            const nameCell = firstRemaining.querySelector(
              `.program-name-cell[data-program-id="${programId}"]`,
            );
            if (nameCell) {
              const addRow = document.getElementById(`add-row-${programId}`);
              nameCell.textContent = addRow.dataset.programName || "";
            }
          }
        }
      }

      function validatePrerequisites() {
        const errors = [];
        const table = document.querySelector(".prerequisites-table");
        if (!table) return true;

        const tbody = table.querySelector("tbody");
        const rows = tbody.querySelectorAll("tr[id^='program-row-']");
        const programMap = new Map();

        rows.forEach((row) => {
          const courseInput = row.querySelector("input[type='text']");
          const selects = row.querySelectorAll("select");
          const typeSelect = selects[0];
          const gradeSelect = selects[1];

          if (!courseInput || !typeSelect || !gradeSelect) return;

          const programId = courseInput.dataset.programId;
          const courseCode = courseInput.value.trim();
          const typeValue = typeSelect.value;
          const gradeValue = gradeSelect.value;

          // Only validate rows with data
          if (!courseCode && !typeValue && !gradeValue) return;

          const courseError = row.querySelectorAll(".course-error")[0];
          const typeError = row.querySelectorAll(".course-error")[1];
          const gradeError = row.querySelectorAll(".course-error")[2];

          let rowValid = true;

          if (!courseCode) {
            if (courseError) courseError.classList.add("show");
            rowValid = false;
          } else {
            if (courseError) courseError.classList.remove("show");
          }

          if (!typeValue) {
            if (typeError) typeError.classList.add("show");
            rowValid = false;
          } else {
            if (typeError) typeError.classList.remove("show");
          }

          // Only require grade if type is "completed"
          if (typeValue === "completed" && !gradeValue) {
            if (gradeError) gradeError.classList.add("show");
            rowValid = false;
          } else {
            if (gradeError) gradeError.classList.remove("show");
          }

          if (rowValid) {
            if (!programMap.has(programId)) {
              programMap.set(programId, []);
            }
            programMap.get(programId).push(courseCode);
          }
        });

        // Check for duplicates within each program
        programMap.forEach((courses, programId) => {
          const duplicates = courses.filter(
            (code, idx) => courses.indexOf(code) !== idx,
          );
          if (duplicates.length > 0) {
            const programNames = Array.from(
              table.querySelectorAll(".program-name-cell"),
            );
            const programName =
              programNames.find((cell) => {
                const firstRow = cell.closest("tr");
                const firstInput = firstRow.querySelector("input[type='text']");
                return firstInput?.dataset.programId === programId;
              })?.textContent || "Program";

            errors.push(
              `${programName}: Kode mata kuliah "${duplicates[0]}" duplikat`,
            );
          }
        });

        if (errors.length > 0) {
          errors.forEach((err) => console.error(err));
        }

        return errors.length === 0;
      }

      function setDefaultPrerequisites() {
        if (!validatePrerequisites()) {
          showErrorDialog(
            "Mohon perbaiki data prasyarat yang ada error sebelum menyimpan default",
          );
          return;
        }

        const pplTypeId = document.getElementById("field-ppl-type").value;
        const selectedPPLType = pplTypes.find((t) => t.id === pplTypeId);

        window.confirmDialog.show({
          type: "confirm",
          icon: "❓",
          title: "Konfirmasi Set Default",
          message: `Apakah Anda yakin ingin mengatur mata kuliah prasyarat saat ini sebagai default untuk jenis PPL "${selectedPPLType?.name}"?`,
          onConfirm: () => {
            // Simulate PUT /ppl-types/{ppl_type_id}/default-prerequisites
            setTimeout(() => {
              window.confirmDialog.show({
                type: "success",
                icon: "✓",
                title: "Default Berhasil Disimpan",
                message: `Mata kuliah prasyarat untuk "${selectedPPLType?.name}" telah disimpan sebagai default.`,
                onConfirm: () => {
                  // Could reload prerequisites here if needed
                },
              });
            }, 500);
          },
        });
      }

      function initializeEditor() {
        editor = new EditorJS({
          holder: "editor-js",
          tools: {
            header: Header,
            list: List,
            quote: Quote,
          },
          placeholder: "Masukkan syarat pendaftaran…",
        });
      }

      function renderMilestones() {
        const list = document.getElementById("milestones-list");
        list.innerHTML = "";
        milestones.forEach((ms, idx) => {
          const item = document.createElement("div");
          item.style.cssText =
            "display:flex;flex-direction:column;gap:0.5rem;padding:0.75rem;background:#f9fafb;border-radius:0.5rem;border:1px solid var(--border)";
          item.innerHTML = `
            <div style="display:flex;justify-content:space-between;align-items:center">
              <label class="form-label" style="margin:0;flex:1">${
                ms.is_default ? "Pendaftaran (Default)" : `Milestone ${idx}`
              }</label>
              ${
                !ms.is_default
                  ? `<button type="button" class="btn btn-link" onclick="removeMilestone(${idx})" style="padding:0;color:var(--danger);font-size:0.75rem">Hapus</button>`
                  : ""
              }
            </div>
            ${
              !ms.is_default
                ? `<input class="form-input" type="text" placeholder="Nama milestone…" value="${ms.title}" onchange="milestones[${idx}].title=this.value" style="font-size:0.875rem" />`
                : ""
            }
            <div class="date-pair" style="grid-template-columns:1fr 1fr;gap:0.5rem">
              <div>
                <label class="form-label" style="margin:0;font-size:0.75rem">Tanggal Mulai</label>
                <input class="form-input" type="date" value="${
                  ms.start_date
                }" onchange="milestones[${idx}].start_date=this.value" style="font-size:0.875rem;margin-top:0.25rem" />
              </div>
              <div>
                <label class="form-label" style="margin:0;font-size:0.75rem">Tanggal Akhir</label>
                <input class="form-input" type="date" value="${
                  ms.end_date
                }" onchange="milestones[${idx}].end_date=this.value" style="font-size:0.875rem;margin-top:0.25rem" />
              </div>
            </div>
          `;
          list.appendChild(item);
        });
      }

      function addMilestone() {
        milestones.push({
          title: "",
          start_date: "",
          end_date: "",
          is_default: false,
        });
        renderMilestones();
      }

      function removeMilestone(idx) {
        milestones.splice(idx, 1);
        renderMilestones();
      }

      function validateMilestones() {
        const errors = [];

        for (let i = 0; i < milestones.length; i++) {
          const ms = milestones[i];
          if (!ms.title)
            errors.push(`Milestone ${i + 1}: nama tidak boleh kosong`);
          if (!ms.start_date)
            errors.push(`Milestone ${i + 1}: tanggal mulai tidak boleh kosong`);
          if (!ms.end_date && i < milestones.length - 1)
            errors.push(`Milestone ${i + 1}: tanggal akhir tidak boleh kosong`);

          if (ms.end_date && new Date(ms.start_date) > new Date(ms.end_date)) {
            errors.push(
              `Milestone ${i + 1}: tanggal mulai tidak boleh melebihi tanggal akhir`,
            );
          }
        }

        // Check for overlapping dates
        for (let i = 0; i < milestones.length - 1; i++) {
          const current = milestones[i];
          const next = milestones[i + 1];
          if (
            current.end_date &&
            next.start_date &&
            new Date(current.end_date) >= new Date(next.start_date)
          ) {
            errors.push(
              `Milestone ${i + 1} dan ${i + 2}: rentang waktu saling bentrok`,
            );
          }
        }

        if (errors.length > 0) {
          const errorEl = document.getElementById("milestone-error");
          errorEl.textContent = errors.join("; ");
          errorEl.style.display = "block";
          return false;
        } else {
          document.getElementById("milestone-error").style.display = "none";
          return true;
        }
      }

      function collectPrerequisitesData() {
        const data = [];
        const table = document.querySelector(".prerequisites-table");
        if (!table) return data;

        const tbody = table.querySelector("tbody");
        const rows = tbody.querySelectorAll("tr[id^='program-row-']");
        const programMap = new Map();

        rows.forEach((row) => {
          const courseInput = row.querySelector("input[type='text']");
          const selects = row.querySelectorAll("select");
          const typeSelect = selects[0];
          const gradeSelect = selects[1];

          if (!courseInput || !typeSelect || !gradeSelect) return;

          const programId = courseInput.dataset.programId;
          const courseCode = courseInput.value.trim();
          const typeValue = typeSelect.value;
          const gradeValue = gradeSelect.value;

          // Only include rows with course code and type
          if (courseCode && typeValue) {
            if (!programMap.has(programId)) {
              programMap.set(programId, []);
            }

            const courseData = {
              course_code: courseCode,
              prerequisite_type: typeValue,
            };

            // Only include minimum_grade if type is "completed"
            if (typeValue === "completed") {
              courseData.minimum_grade = gradeValue || "";
            }

            programMap.get(programId).push(courseData);
          }
        });

        // Convert map to array
        programMap.forEach((courses, programId) => {
          data.push({
            study_program_id: programId,
            courses: courses,
          });
        });

        return data;
      }

      async function submitPeriod(e) {
        e.preventDefault();

        if (!validateMilestones()) return;

        const name = document.getElementById("field-name").value;
        const ppl_type_id = document.getElementById("field-ppl-type").value;
        const start_date = document.getElementById("field-start-date").value;
        const end_date = document.getElementById("field-end-date").value;
        const has_requirements = document.getElementById(
          "field-has-requirements",
        ).checked;

        if (!ppl_type_id) {
          alert("Pilih atau buat jenis PPL terlebih dahulu");
          return;
        }

        // Validate prerequisites if any were added
        if (!validatePrerequisites()) {
          showErrorDialog(
            "Mohon perbaiki data prasyarat sebelum menyimpan periode",
          );
          return;
        }

        // Prepare milestones
        const milestonesData = milestones.map((ms) => ({
          title: ms.title,
          start_date: ms.start_date,
          end_date: ms.end_date || null,
          visible_to: ["admin", "dpl", "mahasiswa"],
        }));

        // Get editor content
        let registration_requirements = null;
        if (has_requirements && editor) {
          const content = await editor.save();
          registration_requirements = JSON.stringify(content);
        }

        // Collect prerequisites data
        const study_program_prerequisites = collectPrerequisitesData();

        const payload = {
          name,
          ppl_type_id,
          start_date,
          end_date,
          registration_start: start_date,
          registration_end: end_date,
          registration_requirements,
          milestones: milestonesData,
          study_program_prerequisites,
        };

        // Show confirmation dialog (Mock - no API call)
        window.confirmDialog.show({
          type: "confirm",
          icon: "❓",
          title: "Konfirmasi Pembuatan Periode",
          message: `Apakah Anda yakin ingin membuat periode "${name}"?`,
          onConfirm: () => {
            window.confirmDialog.show({
              type: "success",
              icon: "✓",
              title: "Periode Berhasil Dibuat",
              message: `Periode "${name}" telah berhasil dibuat.`,
              onConfirm: () => {
                closeModal();
              },
            });
          },
        });
      }

      function showSuccessDialog(message) {
        window.confirmDialog.show({
          type: "success",
          icon: "✓",
          title: "Sukses",
          message,
        });
      }

      function showErrorDialog(message) {
        window.confirmDialog.show({
          type: "error",
          icon: "✕",
          title: "Gagal",
          message,
        });
      }

