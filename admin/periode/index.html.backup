            <!-- Milestone tab -->
            <div class="dtab-panel">
              <div class="flex justify-between items-center mb-4">
                <p class="text-sm text-muted">Kalender milestone periode ini</p>
                <button
                  class="btn btn-primary"
                  onclick="alert('Form tambah milestone')"
                >
                  + Tambah Milestone
                </button>
              </div>
              <div class="card" style="margin-bottom: 0">
                <div class="milestone-item">
                  <div class="milestone-dot" style="background: #f59e0b"></div>
                  <div>
                    <div style="font-weight: 500; font-size: 0.875rem">
                      Buka Pendaftaran
                    </div>
                    <div class="text-sm text-muted">
                      1 Agustus 2026 · Semua peran
                    </div>
                  </div>
                </div>
                <div class="milestone-item">
                  <div class="milestone-dot" style="background: #f59e0b"></div>
                  <div>
                    <div style="font-weight: 500; font-size: 0.875rem">
                      Tutup Pendaftaran &amp; WAR
                    </div>
                    <div class="text-sm text-muted">
                      15 Agustus 2026 · Semua peran
                    </div>
                  </div>
                </div>
                <div class="milestone-item">
                  <div class="milestone-dot"></div>
                  <div>
                    <div style="font-weight: 500; font-size: 0.875rem">
                      Mulai Pelaksanaan PPL
                    </div>
                    <div class="text-sm text-muted">
                      1 September 2026 · Semua peran
                    </div>
