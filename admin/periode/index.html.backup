                    + Tambah Sekolah Mitra
                  </button>
                </div>
              </div>

              <!-- Filter & Search Bar -->
              <div class="filter-bar">
                <input
                  type="text"
                  class="form-input"
                  placeholder="Cari nama sekolah atau NPSN..."
                  id="sekolah-search"
                  style="max-width: 250px"
                  onkeyup="filterSekolahTable()"
                />
                <select
                  class="form-input"
                  id="sekolah-jenjang"
                  style="max-width: 180px"
                  onchange="filterSekolahTable()"
                >
                  <option value="">Semua Jenjang</option>
                  <option value="PAUD/TK">PAUD/TK</option>
                  <option value="SD/MI">SD/MI</option>
                  <option value="SMP/MTs">SMP/MTs</option>
                  <option value="SMA/SMK/MA">SMA/SMK/MA</option>
                  <option value="SLB">SLB</option>
                </select>
                <select
                  class="form-input"
                  id="sekolah-prodi"
                  style="max-width: 200px"
                  onchange="filterSekolahTable()"
                >
                  <option value="">Semua Program Studi</option>
                  <option value="PAI">Pendidikan Agama Islam (PAI)</option>
                  <option value="PBA">Pendidikan Bahasa Arab (PBA)</option>
                  <option value="PGMI">PGMI</option>
                  <option value="PG Paud">PG PAUD</option>
                </select>
              </div>

              <!-- Table -->
              <div style="overflow-x: auto">
                <table class="table" style="width: 100%; min-width: 900px">
                  <thead>
                    <tr>
                      <th
                        style="width: 4%; cursor: pointer"
                        onclick="sortSekolahTable('no')"
                      >
                        No
                      </th>
                      <th
                        style="width: 20%; cursor: pointer"
                        onclick="sortSekolahTable('nama')"
                      >
                        Nama Sekolah
                      </th>
                      <th
                        style="width: 12%; cursor: pointer"
                        onclick="sortSekolahTable('npsn')"
                      >
                        NPSN
                      </th>
                      <th
                        style="width: 14%; cursor: pointer"
                        onclick="sortSekolahTable('jenjang')"
                      >
                        Jenjang
                      </th>
                      <th
                        style="width: 15%; cursor: pointer"
                        onclick="sortSekolahTable('pic')"
                      >
                        PIC
                      </th>
                      <th
                        style="width: 20%; cursor: pointer"
                        onclick="sortSekolahTable('kuota')"
                      >
                        Kuota
                      </th>
                      <th style="width: 15%">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="sekolah-tbody">
                    <!-- Akan diisi oleh JavaScript -->
                  </tbody>
                </table>
              </div>

              <!-- Pagination -->
              <div
                class="flex justify-between items-center"
                style="margin-top: 1.5rem"
              >
                <div class="text-sm text-muted" id="sekolah-page-info">
                  Halaman 1 dari 1
                </div>
                <div style="display: flex; gap: 0.5rem">
                  <button
                    class="btn btn-outline"
                    onclick="prevSekolahPage()"
                    style="padding: 0.375rem 0.625rem"
                  >
                    ← Sebelumnya
                  </button>
                  <button
                    class="btn btn-outline"
                    onclick="nextSekolahPage()"
                    style="padding: 0.375rem 0.625rem"
                  >
                    Berikutnya →
                  </button>
                </div>
              </div>
            </div>

            <!-- Rubrik tab -->
            <div class="dtab-panel">
              <div
                style="
                  display: grid;
                  grid-template-columns: 1fr 1fr;
                  gap: 1rem;
                  margin-bottom: 1rem;
                "
              >
                <div>
                  <label class="form-label">Prodi</label>
                  <select class="form-input" onchange="loadRubrik(this.value)">
                    <option value="pai">Pendidikan Agama Islam (PAI)</option>
                    <option value="pba">Pendidikan Bahasa Arab (PBA)</option>
                    <option value="pgmi">PGMI</option>
                  </select>
                </div>
              </div>
              <div class="card" style="margin-bottom: 0">
                <div class="flex justify-between items-center mb-4">
                  <h3 style="font-size: 0.875rem; font-weight: 600">
                    Rubrik — PAI
                  </h3>
                  <button
                    class="btn btn-primary"
                    onclick="alert('Rubrik berhasil disimpan.')"
                  >
                    Simpan
                  </button>
                </div>
                <textarea
                  class="form-input"
                  style="
                    height: 220px;
                    font-family: monospace;
                    font-size: 0.8125rem;
                  "
                >
## Rubrik Penilaian PPL — PAI

### Komponen Penilaian
| Komponen | Bobot |
|---|---|
| Perangkat Pembelajaran | 30% |
| Praktik Mengajar | 40% |
| Laporan PPL | 30% |

### Catatan
- Rubrik ini hanya sebagai panduan
- Perhitungan nilai sepenuhnya kewenangan DPL</textarea
                >
                <p class="text-sm text-muted" style="margin-top: 0.5rem">
                  Format Markdown. Rubrik hanya panduan — perhitungan nilai
                  kewenangan DPL.
                </p>
              </div>
            </div>

            <!-- Pengumuman tab -->
            <div class="dtab-panel">
              <div class="flex justify-between items-center mb-4">
                <p class="text-sm text-muted">3 pengumuman</p>
                <button
                  class="btn btn-primary"
                  onclick="alert('Form buat pengumuman')"
                >
                  + Buat Pengumuman
                </button>
              </div>
              <div style="display: flex; flex-direction: column; gap: 0.75rem">
                <div class="card" style="margin-bottom: 0; padding: 1rem">
                  <div
                    class="flex justify-between items-center"
                    style="margin-bottom: 0.375rem"
                  >
                    <div style="font-weight: 600; font-size: 0.9375rem">
                      Panduan Teknis Pendaftaran PPL Ganjil 2026
                    </div>
                    <span class="badge badge-success">Published</span>
                  </div>
                  <div class="text-sm text-muted" style="margin-bottom: 0.5rem">
                    Dipublikasikan 2 hari lalu · oleh Super Admin
                  </div>
                  <div style="display: flex; gap: 0.5rem">
                    <span
                      style="
                        font-size: 0.75rem;
                        background: #f3f4f6;
                        padding: 0.2rem 0.6rem;
                        border-radius: 4px;
                      "
                      >📎 panduan.pdf</span
                    >
                    <span
                      style="
                        font-size: 0.75rem;
                        background: #f3f4f6;
                        padding: 0.2rem 0.6rem;
                        border-radius: 4px;
                      "
                      >🎬 Video Sosialisasi</span
                    >
                  </div>
                </div>
                <div class="card" style="margin-bottom: 0; padding: 1rem">
                  <div
                    class="flex justify-between items-center"
                    style="margin-bottom: 0.375rem"
                  >
                    <div style="font-weight: 600; font-size: 0.9375rem">
                      Daftar Sekolah Mitra Periode Ganjil 2026
                    </div>
                    <span class="badge badge-success">Published</span>
                  </div>
                  <div class="text-sm text-muted">
                    Dipublikasikan 5 hari lalu · oleh Super Admin
                  </div>
                </div>
                <div
