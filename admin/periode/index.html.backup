      function renderSekolahTable() {
        const tbody = document.getElementById("sekolah-tbody");
        const start = (sekolahCurrentPage - 1) * sekolahPerPage;
        const end = start + sekolahPerPage;
        const paginatedData = sekolahTableData.slice(start, end);

        tbody.innerHTML = "";
        paginatedData.forEach((sekolah, idx) => {
          const rowNum = start + idx + 1;
          const kuotaText = sekolah.kuota
            .map((k) => `${k.prodi}: ${k.kuota}`)
            .join(" | ");
          const totalKuota = sekolah.kuota.reduce((sum, k) => sum + k.kuota, 0);

          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td style="text-align: center">${rowNum}</td>
            <td>
              <div style="font-weight: 500">${sekolah.nama}</div>
              <div class="text-sm text-muted">NPSN: ${sekolah.npsn}</div>
            </td>
