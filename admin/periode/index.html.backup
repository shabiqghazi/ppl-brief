<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Periode PPL — PPL FTK</title>
    <link rel="stylesheet" href="../../assets/css/main.css" />
    <style>
      .nav-section {
        padding: 0.25rem 1.5rem;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #6b7280;
        margin-top: 0.75rem;
      }
      .sidebar-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #1f2937;
      }
      .sidebar-footer a {
        color: #9ca3af;
        font-size: 0.875rem;
        text-decoration: none;
      }
      /* Views */
      .view {
        display: none;
      }
      .view.active {
        display: block;
      }
      /* Period cards */
      .period-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
      }
      .period-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1.25rem;
        cursor: pointer;
        transition:
          border-color 0.15s,
          box-shadow 0.15s;
      }
      .period-card:hover {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1);
      }
      /* Status badges */
      .s-draft {
        background: #f3f4f6;
        color: #6b7280;
      }
      .s-published {
        background: #dbeafe;
        color: #1e40af;
      }
      .s-registration {
        background: #fef3c7;
        color: #92400e;
      }
      .s-active {
        background: #d1fae5;
        color: #065f46;
      }
      .s-closed {
        background: #f3f4f6;
        color: #374151;
      }
      /* Tabs */
      .dtabs {
        display: flex;
        border-bottom: 1px solid var(--border);
        margin-bottom: 1.5rem;
      }
      .dtab {
        padding: 0.625rem 1.25rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
      }
      .dtab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
      }
      .dtab-panel {
        display: none;
      }
      .dtab-panel.active {
        display: block;
      }
      /* Modal overlay */
      .overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 50;
        align-items: center;
        justify-content: center;
      }
      .overlay.open {
        display: flex;
      }
      .modal {
        background: var(--white);
        border-radius: 0.75rem;
        padding: 1.5rem;
        width: 100%;
        max-width: 560px;
        max-height: 90vh;
        overflow-y: auto;
      }
      .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
      }
      .date-pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }
      .info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border);
      }
      .info-row:last-child {
        border-bottom: none;
      }
      .milestone-item {
        display: flex;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border);
      }
      .milestone-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--primary);
        margin-top: 4px;
        flex-shrink: 0;
      }
      .filter-bar {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }
      /* Prerequisites Section */
      .prerequisites-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
      }
      .prerequisites-table thead {
        background: #f3f4f6;
      }
      .prerequisites-table th {
        padding: 0.625rem;
        text-align: left;
        font-weight: 600;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border);
        font-size: 0.75rem;
      }
      .prerequisites-table td {
        padding: 0.625rem;
        border-bottom: 1px solid var(--border);
      }
      .prerequisites-table tbody tr:hover {
        background: #f9fafb;
      }
      .program-name-cell {
        font-weight: 500;
        color: var(--text-main);
      }
      .course-cell {
        padding: 0.375rem 0.625rem;
      }
      .course-row {
        display: grid;
        grid-template-columns: 1.5fr 1.2fr 1.2fr 40px;
        gap: 0.5rem;
        align-items: flex-end;
        margin-bottom: 0.375rem;
      }
      .course-row:last-child {
        margin-bottom: 0;
      }
      .course-row-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
        font-weight: 500;
      }
      .course-input-group {
        display: flex;
        flex-direction: column;
      }
      .course-error {
        color: var(--danger);
        font-size: 0.7rem;
        margin-top: 0.125rem;
        display: none;
      }
      .course-error.show {
        display: block;
      }
      .form-input.has-error {
        border-color: var(--danger);
      }
      .add-course-btn {
        padding: 0.5rem 0.625rem;
        font-size: 0.75rem;
        color: var(--primary);
        background: none;
        border: 1px dashed var(--border);
        cursor: pointer;
        margin-top: 0.375rem;
        border-radius: 0.375rem;
        transition: all 0.2s;
      }
      .add-course-btn:hover {
        border-color: var(--primary);
        background: rgba(79, 70, 229, 0.05);
      }
      .prerequisite-type-hidden {
        display: none;
      }
      .prerequisite-program-header {
        background: #f9fafb;
        padding: 0.75rem 0.625rem;
        margin: 0.75rem 0 0.375rem 0;
        border-radius: 0.375rem;
        border-bottom: 1px solid var(--border);
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-main);
      }
      .prerequisite-program-meta {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-left: auto;
        font-weight: normal;
      }
      /* Prerequisites table header enhancement */
      .prerequisites-table thead th {
        font-size: 0.75rem;
        font-weight: 600;
      }
      /* Delete button styling */
      .delete-prereq-btn {
        padding: 0.25rem;
        font-size: 1rem;
        color: var(--danger);
        background: none;
        border: none;
        cursor: pointer;
        height: 24px;
        width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }
      .delete-prereq-btn:hover {
        background: #fee2e2;
        border-radius: 0.25rem;
      }
      /* Program studi section styling */
      .prerequisites-program-section {
        background: white;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1rem;
      }
      .prerequisites-program-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
      }
      .prerequisites-program-header input[type="checkbox"] {
        cursor: pointer;
        width: 18px;
        height: 18px;
      }
      .prerequisites-program-title {
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--text-main);
        flex: 1;
      }
      .prerequisites-program-courses {
        display: none;
      }
      .prerequisites-program-courses.active {
        display: block;
      }
      .prerequisite-course-rows {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .prerequisite-course-row {
        display: grid;
        grid-template-columns: 1.5fr 1.2fr 1.2fr 40px;
        gap: 0.75rem;
        align-items: flex-end;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 0.375rem;
        border: 1px solid var(--border);
      }
      .prerequisite-course-row.empty-state {
        grid-template-columns: 1fr;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.875rem;
        padding: 1rem;
      }
      .prerequisite-course-field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .prerequisite-course-field label {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-muted);
      }
      .prerequisite-course-field input,
      .prerequisite-course-field select {
        font-size: 0.875rem;
      }
      .add-prerequisite-row-btn {
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        color: var(--primary);
        background: none;
        border: 1px dashed var(--border);
        cursor: pointer;
        border-radius: 0.375rem;
        transition: all 0.2s;
        width: 100%;
        text-align: center;
      }
      .add-prerequisite-row-btn:hover {
        border-color: var(--primary);
        background: rgba(79, 70, 229, 0.05);
      }
      .prerequisites-select-all {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        align-items: center;
      }
      .prerequisites-select-all input[type="checkbox"] {
        cursor: pointer;
        width: 18px;
        height: 18px;
      }
      .prerequisites-select-all label {
        margin: 0;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
      }
      .prerequisites-info {
        background: #dbeafe;
        border: 1px solid #93c5fd;
        color: #0369a1;
        padding: 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        margin-bottom: 1rem;
      }
      .set-default-checkbox-group {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .set-default-checkbox-group input[type="checkbox"] {
        cursor: pointer;
        width: 18px;
        height: 18px;
      }
      .set-default-checkbox-group label {
        margin: 0;
        font-size: 0.875rem;
        cursor: pointer;
        flex: 1;
      }
      .set-default-checkbox-group input[type="checkbox"]:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .set-default-checkbox-group input[type="checkbox"]:disabled + label {
        opacity: 0.5;
        cursor: not-allowed;
      }

      /* ── Prerequisites Table ─────────────────────────── */
      .prereq-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
      }
      .prereq-table thead th {
        background: #f3f4f6;
        padding: 0.625rem 0.75rem;
        text-align: left;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
        border-bottom: 2px solid var(--border);
        white-space: nowrap;
      }
      .prereq-td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
      }
      .prereq-td--checkbox {
        text-align: center;
        vertical-align: middle;
        background: #fafafa;
        border-right: 1px solid var(--border);
      }
      .prereq-td--name {
        font-weight: 500;
        color: #1a202c;
        vertical-align: middle;
        background: #fafafa;
        border-right: 1px solid var(--border);
        min-width: 160px;
      }
      .prereq-td--action {
        text-align: center;
        white-space: nowrap;
      }
      .prereq-td--empty {
        color: var(--text-muted);
      }
      .prereq-row--unchecked td:not(.prereq-td--checkbox) {
        opacity: 0.4;
      }
      .prereq-table
        tbody
        tr:hover
        .prereq-td:not(.prereq-td--checkbox):not(.prereq-td--name) {
        background: #f9fafb;
      }
      .prereq-input {
        width: 100%;
        min-width: 80px;
        padding: 0.375rem 0.5rem;
        font-size: 0.8125rem;
      }
      .prereq-empty-msg {
        color: var(--text-muted);
        font-size: 0.8125rem;
        margin-right: 1rem;
      }
      .prereq-add-btn {
        background: none;
        border: 1px dashed var(--border);
        color: var(--primary);
        font-size: 0.8125rem;
        padding: 0.3rem 0.75rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.15s;
      }
      .prereq-add-btn:hover {
        border-color: var(--primary);
        background: rgba(79, 70, 229, 0.04);
      }
      .prereq-row--add td {
        padding: 0.25rem 0.75rem;
        border-bottom: 2px solid var(--border);
      }
      .prereq-del-btn {
        background: none;
        border: none;
        color: #dc2626;
        font-size: 1.125rem;
        line-height: 1;
        cursor: pointer;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        transition: background 0.15s;
      }
      .prereq-del-btn:hover {
        background: #fee2e2;
      }
      .prereq-program-cb {
        width: 16px;
        height: 16px;
        cursor: pointer;
      }

      /* ── Drawer Styles ─────────────────────────── */
      .drawer-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 50;
      }
      .drawer-overlay.open {
        display: block;
      }
      .drawer {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: 100%;
        max-width: 500px;
        background: var(--white);
        box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        z-index: 51;
        transform: translateX(100%);
        transition: transform 0.3s ease;
      }
      .drawer-overlay.open .drawer {
        transform: translateX(0);
      }
      .drawer-header {
        padding: 1.5rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .drawer-header h2 {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
      }
      .drawer-close {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.25rem;
        color: var(--text-muted);
      }
      .drawer-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
      }
      .drawer-footer {
        padding: 1.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
      }

      /* Toggle Mode Button */
      .toggle-mode-group {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1rem;
      }
      .toggle-mode-btn {
        flex: 1;
        padding: 0.625rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        cursor: pointer;
        color: var(--text-muted);
        transition: all 0.2s;
      }
      .toggle-mode-btn.active {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
      }
      .toggle-mode-btn:hover {
        border-color: var(--primary);
      }

      /* Dynamic Array for Kuota */
      .kuota-rows {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }
      .kuota-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 40px;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 0.375rem;
        border: 1px solid var(--border);
      }
      .kuota-row-field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .kuota-row-field label {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-muted);
      }
      .kuota-row-delete {
        padding: 0.25rem;
        font-size: 1rem;
        color: var(--danger);
        background: none;
        border: none;
        cursor: pointer;
        height: 24px;
        width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        margin-top: auto;
      }
      .kuota-row-delete:hover {
        background: #fee2e2;
        border-radius: 0.25rem;
      }
      .add-kuota-row-btn {
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        color: var(--primary);
        background: none;
        border: 1px dashed var(--border);
        cursor: pointer;
        border-radius: 0.375rem;
        transition: all 0.2s;
        width: 100%;
        text-align: center;
      }
      .add-kuota-row-btn:hover {
        border-color: var(--primary);
        background: rgba(79, 70, 229, 0.05);
      }

      /* School Search Results */
      .school-search-results {
        display: none;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        max-height: 300px;
        overflow-y: auto;
        margin-bottom: 1rem;
      }
      .school-search-results.open {
        display: block;
      }
      .school-item {
        padding: 0.75rem;
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        transition: background 0.2s;
      }
      .school-item:last-child {
        border-bottom: none;
      }
      .school-item:hover {
        background: #f9fafb;
      }
      .school-item.disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .school-item-name {
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--text-main);
      }
      .school-item-meta {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
      }
      .school-item-badge {
        display: inline-block;
        background: #fee2e2;
        color: #991b1b;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.65rem;
        font-weight: 600;
        margin-top: 0.25rem;
      }

      /* Confirmation Modal */
      .confirm-modal-text {
        font-size: 0.9375rem;
        line-height: 1.6;
        color: var(--text-main);
        margin-bottom: 1.5rem;
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <aside class="sidebar">
        <div class="sidebar-header">PPL FTK — Admin</div>
        <nav class="sidebar-nav">
          <a href="../dashboard/" class="nav-item">📊 Dashboard</a>
          <div class="nav-section">M1 — SALAM &amp; SSO</div>
          <a href="../salam/" class="nav-item">🔗 Integrasi SALAM</a>
          <div class="nav-section">M2 — Periode PPL</div>
          <a href="../periode/" class="nav-item active">📅 Periode PPL</a>
          <a href="../mitra/" class="nav-item">🏫 Sekolah Mitra</a>
          <a href="../program-studi/" class="nav-item">📚 Program Studi</a>
          <div class="nav-section">M3 — Pendaftaran</div>
          <a href="../pendaftaran/" class="nav-item">📝 Pendaftaran</a>
          <a href="../penempatan/" class="nav-item">📌 Penempatan &amp; DPL</a>
          <a href="../laporan/" class="nav-item">📄 Laporan &amp; Surat</a>
<a href="../audit-trail/" class="nav-item active">🔍 Audit Trail</a>
        </nav>
        <div class="sidebar-footer">
          <a href="../../index.html">← Keluar</a>
        </div>
      </aside>

      <div class="main-content">
        <header class="top-bar">
          <div style="display: flex; align-items: center; gap: 0.75rem">
            <button
              id="btn-back"
              onclick="showList()"
              style="
                display: none;
                background: none;
                border: none;
                cursor: pointer;
                color: var(--text-muted);
                font-size: 0.875rem;
              "
            >
              ← Kembali
            </button>
            <h1 id="page-title" style="font-size: 1.125rem; font-weight: 600">
              Periode PPL
            </h1>
          </div>
          <div style="display: flex; align-items: center; gap: 1rem">
            <span class="text-sm text-muted">Super Admin</span>
            <div
              style="
                width: 32px;
                height: 32px;
                background: var(--primary);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 0.75rem;
                font-weight: 700;
              "
            >
              SA
            </div>
          </div>
        </header>

        <main class="page-container">
          <!-- LIST VIEW -->
          <div class="view active" id="view-list">
            <!-- Filter Section -->
            <div class="filter-bar">
              <select class="form-input" style="max-width: 180px">
                <option value="">Semua Status</option>
                <option value="UPCOMING">Belum Dimulai</option>
                <option value="ACTIVE">Aktif</option>
                <option value="CLOSED">Selesai</option>
              </select>
              <select class="form-input" style="max-width: 200px">
                <option value="">Semua Jenis PPL</option>
                <option value="reguler">PPL Reguler</option>
                <option value="internasional">PPL Internasional</option>
              </select>
              <div style="margin-left: auto; display: flex; gap: 0.5rem">
                <button class="btn btn-primary" onclick="openModal()">
                  + Buat Periode Baru
                </button>
              </div>
            </div>

            <!-- Result Info & Cards -->
            <p class="text-sm text-muted" style="margin-bottom: 1rem">
              2 periode ditemukan
            </p>
            <div class="period-cards">
              <!-- Card 1: Aktif -->
              <div class="period-card" onclick="showDetail('Ganjil 2026/2027')">
                <div
                  class="flex justify-between items-start"
                  style="margin-bottom: 0.75rem"
                >
                  <span class="badge s-ongoing">Pendaftaran</span>
                  <button
                    class="btn btn-link"
                    style="
                      padding: 0;
                      font-size: 1.25rem;
                      color: var(--text-muted);
                      border: none;
