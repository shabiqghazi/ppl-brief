        buttons.forEach((btn) => btn.classList.remove("active"));

        if (mode === "pilih") {
          buttons[0].classList.add("active");
          document.getElementById("mode-pilih-sekolah").style.display = "block";
          document.getElementById("mode-buat-sekolah").style.display = "none";
        } else {
          buttons[1].classList.add("active");
          document.getElementById("mode-pilih-sekolah").style.display = "none";
          document.getElementById("mode-buat-sekolah").style.display = "block";
        }
      }

