                  <div class="info-row">
                    <span class="text-muted">Persiapan</span
                    ><span>16 – 31 Agu 2026</span>
                  </div>
                  <div class="info-row">
                    <span class="text-muted">Pelaksanaan</span
                    ><span>1 Sep – 31 Okt 2026</span>
                  </div>
                  <div class="info-row">
                    <span class="text-muted">Pelaporan</span
                    ><span>1 – 30 Nov 2026</span>
                  </div>
                </div>
                <div class="card" style="margin-bottom: 0">
                  <h3
                    style="
                      font-size: 0.875rem;
                      font-weight: 600;
                      margin-bottom: 0.75rem;
                    "
                  >
                    Syarat Pendaftaran
