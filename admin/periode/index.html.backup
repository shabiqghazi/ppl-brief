            </td>
          `;
          tbody.appendChild(tr);
        });

        updateSekolahPagination();
      }

      function updateSekolahPagination() {
        const totalPages = Math.ceil(sekolahTableData.length / sekolahPerPage);
        document.getElementById("sekolah-page-info").textContent =
          `Halaman ${sekolahCurrentPage} dari ${totalPages}`;
        document.getElementById("sekolah-count").textContent =
          `${sekolahTableData.length} sekolah mitra terdaftar`;
      }

      function filterSekolahTable() {
        const searchTerm = document
          .getElementById("sekolah-search")
          .value.toLowerCase();
        const jenjangFilter = document.getElementById("sekolah-jenjang").value;
        const prodiFilter = document.getElementById("sekolah-prodi").value;

        sekolahTableData = mockSekolahData.filter((sekolah) => {
          const matchSearch =
            sekolah.nama.toLowerCase().includes(searchTerm) ||
            sekolah.npsn.includes(searchTerm);
          const matchJenjang =
            !jenjangFilter || sekolah.jenjang === jenjangFilter;
          const matchProdi =
            !prodiFilter || sekolah.kuota.some((k) => k.prodi === prodiFilter);
          return matchSearch && matchJenjang && matchProdi;
        });

        sekolahCurrentPage = 1;
        sortSekolahTable(sekolahSortBy);
      }

      function sortSekolahTable(column) {
        if (sekolahSortBy === column) {
          sekolahSortOrder = sekolahSortOrder === "asc" ? "desc" : "asc";
        } else {
          sekolahSortBy = column;
          sekolahSortOrder = "asc";
        }

        sekolahTableData.sort((a, b) => {
          let aVal, bVal;
          if (column === "nama") {
            aVal = a.nama;
            bVal = b.nama;
          } else if (column === "npsn") {
            aVal = a.npsn;
            bVal = b.npsn;
          } else if (column === "jenjang") {
            aVal = a.jenjang;
            bVal = b.jenjang;
          } else if (column === "pic") {
            aVal = a.pic_nama || "";
            bVal = b.pic_nama || "";
          } else if (column === "kuota") {
            aVal = a.kuota.reduce((sum, k) => sum + k.kuota, 0);
            bVal = b.kuota.reduce((sum, k) => sum + k.kuota, 0);
          }

          if (typeof aVal === "string") {
            return sekolahSortOrder === "asc"
              ? aVal.localeCompare(bVal)
              : bVal.localeCompare(aVal);
          } else {
            return sekolahSortOrder === "asc" ? aVal - bVal : bVal - aVal;
          }
        });

        sekolahCurrentPage = 1;
        renderSekolahTable();
      }

      function nextSekolahPage() {
        const maxPage = Math.ceil(sekolahTableData.length / sekolahPerPage);
        if (sekolahCurrentPage < maxPage) {
          sekolahCurrentPage++;
          renderSekolahTable();
        }
      }

      function prevSekolahPage() {
        if (sekolahCurrentPage > 1) {
          sekolahCurrentPage--;
          renderSekolahTable();
        }
      }

