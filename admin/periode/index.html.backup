      // Modal: Confirm Cabut
      function openConfirmCabut(sekolahId) {
        const sekolah = mockSekolahData.find((s) => s.id === sekolahId);
        if (!sekolah) return;
        currentEditingSekolahId = sekolahId;
        document.getElementById("confirm-sekolah-nama").textContent =
          sekolah.nama;
        document.getElementById("confirm-cabut-overlay").classList.add("open");
      }

      function closeConfirmCabut(e) {
        if (
          !e ||
          e.target === document.getElementById("confirm-cabut-overlay")
        ) {
          document
            .getElementById("confirm-cabut-overlay")
            .classList.remove("open");
        }
      }

      function confirmCabut() {
        if (!currentEditingSekolahId) return;
        const sekolah = mockSekolahData.find(
          (s) => s.id === currentEditingSekolahId,
        );
        alert(`Sekolah mitra "${sekolah.nama}" berhasil dicabut`);
        closeConfirmCabut();
        filterSekolahTable();
      }

      // Initialize
      window.addEventListener("DOMContentLoaded", () => {
        initSekolahTable();
        // Include the base-confirm-dialog
        fetch("/app/shared/components/base-confirm-dialog.html")
          .then((r) => r.text())
          .then((html) => {
            document.body.insertAdjacentHTML("afterbegin", html);
          })
          .catch((err) => console.error("Error loading dialog:", err));
      });
    </script>
  </body>
</html>
