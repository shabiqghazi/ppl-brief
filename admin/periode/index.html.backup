              </div>
              <div class="dtab" onclick="switchDTab(1)">Sekolah Mitra</div>
              <div class="dtab" onclick="switchDTab(2)">Rubrik Penilaian</div>
              <div class="dtab" onclick="switchDTab(3)">Pengumuman</div>
              <div class="dtab" onclick="switchDTab(4)">Milestone</div>
            </div>

            <!-- Info tab -->
            <div class="dtab-panel active">
              <div
                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem"
              >
                <div class="card" style="margin-bottom: 0">
                  <h3
                    style="
                      font-size: 0.875rem;
                      font-weight: 600;
                      margin-bottom: 0.75rem;
                    "
